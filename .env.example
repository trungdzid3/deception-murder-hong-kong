# ================================================================
# BIẾN MÔI TRƯỜNG CHO FRONTEND (Vercel)
# ================================================================
# Sau khi deploy server.js lên Railway, copy URL Railway vào đây.
# Ví dụ: VITE_SOCKET_URL=https://deception-server.up.railway.app
VITE_SOCKET_URL=https://YOUR-RAILWAY-URL.up.railway.app

# ================================================================
# BIẾN MÔI TRƯỜNG CHO BACKEND (Railway)
# ================================================================
# Sau khi deploy frontend lên Vercel, set biến này trên Railway
# để CORS chỉ cho phép Vercel domain kết nối vào.
# Ví dụ: FRONTEND_URL=https://deception-murder-hong-kong.vercel.app
FRONTEND_URL=https://YOUR-VERCEL-URL.vercel.app

PORT=3001
